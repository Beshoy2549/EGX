{
  "name": "egx-market",
  "version": "2.0.0",
  "description": "Fast EGX market data (Yahoo fetch) + Vue dashboard",
  "type": "module",
  "scripts": {
    "scrape": "node src/scrape.js",
    "watch": "INTERVAL=10 node src/watch.js",
    "view": "vite --config web/vite.config.js",
    "dev": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.7"
  }
}
