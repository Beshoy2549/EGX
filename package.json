{
  "name": "egx-market",
  "version": "2.0.0",
  "description": "Fast EGX market data (Yahoo fetch) + Vue dashboard",
  "type": "module",
  "scripts": {
    "scrape": "node src/scrape.js",
    "watch": "INTERVAL=20 node src/watch.js",
    "api": "node src/server.js",
    "view": "vite --config web/vite.config.js",
    "dev": "node scripts/dev-all.js",
    "build": "vite build --config web/vite.config.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.27",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.7"
  }
}
