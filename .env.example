# Copy to .env and fill in your key:
#   cp .env.example .env

# AI provider used by the server when the frontend doesn't override it.
# Options: cursor (default) | openai
AI_PROVIDER=cursor

# Cursor Agent SDK key (used when provider = cursor)
CURSOR_API_KEY=

# OpenAI / ChatGPT (used when provider = openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

API_PORT=8787

# Frontend static login (optional — defaults shown)
# VITE_AUTH_EMAIL=admin@egx.local
# VITE_AUTH_PASSWORD=egx1234
# Dev backdoor value for ?devbypass=… (default: 1)
# VITE_AUTH_BYPASS=1
